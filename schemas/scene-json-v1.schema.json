{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dobedub.studio/schemas/scene-json-v1.schema.json",
  "title": "DOBEDUB STUDIO Scene JSON v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "workflowId",
    "segmentIndex",
    "language",
    "genres",
    "contentRating",
    "scenes",
    "constraints"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "workflowId": {
      "type": [
        "string",
        "null"
      ]
    },
    "segmentIndex": {
      "type": [
        "integer",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "genres": {
      "$ref": "#/$defs/stringList"
    },
    "contentRating": {
      "$ref": "#/$defs/stringList"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sceneItem"
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sceneItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequenceNo",
        "summary",
        "description",
        "camera",
        "environment",
        "style",
        "motion",
        "quality",
        "negativeTerms"
      ],
      "properties": {
        "sequenceNo": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "camera": {
          "$ref": "#/$defs/camera"
        },
        "environment": {
          "$ref": "#/$defs/environment"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "motion": {
          "$ref": "#/$defs/motion"
        },
        "quality": {
          "$ref": "#/$defs/stringList"
        },
        "negativeTerms": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "movement",
        "angle",
        "lens",
        "focus"
      ],
      "properties": {
        "framing": {
          "$ref": "#/$defs/stringList"
        },
        "movement": {
          "$ref": "#/$defs/stringList"
        },
        "angle": {
          "$ref": "#/$defs/stringList"
        },
        "lens": {
          "$ref": "#/$defs/stringList"
        },
        "focus": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "location",
        "timeOfDay",
        "weather"
      ],
      "properties": {
        "background": {
          "$ref": "#/$defs/stringList"
        },
        "location": {
          "$ref": "#/$defs/stringList"
        },
        "timeOfDay": {
          "$ref": "#/$defs/stringList"
        },
        "weather": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lighting",
        "colorPalette",
        "mood",
        "animationStyle",
        "renderingStyle"
      ],
      "properties": {
        "lighting": {
          "$ref": "#/$defs/stringList"
        },
        "colorPalette": {
          "$ref": "#/$defs/stringList"
        },
        "mood": {
          "$ref": "#/$defs/stringList"
        },
        "animationStyle": {
          "$ref": "#/$defs/stringList"
        },
        "renderingStyle": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "speed",
        "intensity"
      ],
      "properties": {
        "speed": {
          "$ref": "#/$defs/stringList"
        },
        "intensity": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
